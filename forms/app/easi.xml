<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Everyday Abilities Scale for India (EASI)</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="easi" version="2026-11-05 17-00" prefix="J1!easi!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source/>
            <source_id/>
            <user>
              <contact_id/>
              <name/>
            </user>
            <contact>
              <_id/>
              <patient_id/>
              <name/>
              <date_of_birth/>
              <sex/>
              <age/>
              <phone/>
            </contact>
          </inputs>
          <patient_uuid/>
          <patient_id/>
          <patient_name/>
          <screened_by/>
          <screened_by_name/>
          <g_participant>
            <consent_confirmed/>
            <patient_name_display/>
            <assessment_date/>
            <dob/>
          </g_participant>
          <grp_easi_scale>
            <_Instructions_easi/>
            <easi_raw1/>
            <easi_q1/>
            <easi_raw2/>
            <easi_q2/>
            <easi_raw3/>
            <easi_q3/>
            <easi_raw4/>
            <easi_q4/>
            <easi_raw5/>
            <easi_q5/>
            <easi_raw6/>
            <easi_q6/>
            <easi_raw7/>
            <easi_q7/>
            <easi_raw8/>
            <easi_q8/>
            <easi_raw9/>
            <easi_q9/>
            <easi_raw10/>
            <easi_q10/>
            <easi_raw11/>
            <easi_q11/>
            <easi_raw12/>
            <easi_q12/>
            <easi_total/>
            <_NOTE_easi/>
            <display_score_easi/>
            <Survey_Status_easi/>
            <Reason_for_Dropout_easi/>
          </grp_easi_scale>
          <g_supporting_docs>
            <upload_scale_image/>
            <upload_scale_pdf/>
          </g_supporting_docs>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
          <item>
            <name>_not_completed___unable_to_und</name>
            <label>Not completed - Unable to understand / answer (comprehension barrier)</label>
          </item>
          <item>
            <name>nc_instruct</name>
            <label>Not completed - Unable to follow instructions (could not complete tasks as instructed)</label>
          </item>
          <item>
            <name>nc_dropout</name>
            <label>Not completed - Dropout (left early / discontinued)</label>
          </item>
        </root>
      </instance>
      <instance id="easi_yesno">
        <root>
          <item>
            <name>1</name>
            <label>Yes</label>
          </item>
          <item>
            <name>0</name>
            <label>No</label>
          </item>
          <item>
            <name>99</name>
            <label>Not completed - Unable to understand / answer (comprehension barrier)</label>
          </item>
          <item>
            <name>98</name>
            <label>Not completed - Unable to follow instructions (could not complete tasks as instructed)</label>
          </item>
          <item>
            <name>97</name>
            <label>Not completed - Dropout (left early / discontinued)</label>
          </item>
        </root>
      </instance>
      <instance id="easi_status">
        <root>
          <item>
            <name>completed</name>
            <label>Completed</label>
          </item>
          <item>
            <name>dropout___discontinued</name>
            <label>Dropout / Discontinued</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/age" type="string"/>
      <bind nodeset="/data/inputs/contact/phone" type="string"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" calculate="coalesce(../inputs/contact/patient_id, ../inputs/contact/_id)"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/screened_by" type="string" calculate="../inputs/user/contact_id"/>
      <bind nodeset="/data/screened_by_name" type="string" calculate="../inputs/user/name"/>
      <bind nodeset="/data/g_participant/consent_confirmed" type="string" required="true()"/>
      <bind nodeset="/data/g_participant/patient_name_display" type="string" required="true()" calculate="if(. = '',  /data/patient_name , .)"/>
      <bind nodeset="/data/g_participant/assessment_date" type="date" required="true()" calculate="if(. = '', today(), .)" constraint=". &lt;= today()" jr:constraintMsg="Date of assessment cannot be in the future."/>
      <bind nodeset="/data/g_participant/dob" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="Date of birth cannot be in the future."/>
      <bind nodeset="/data/grp_easi_scale/_Instructions_easi" readonly="true()" type="string"/>
      <bind nodeset="/data/grp_easi_scale/easi_raw1" type="string" required="true()"/>
      <bind nodeset="/data/grp_easi_scale/easi_q1" type="string" calculate="if( /data/grp_easi_scale/easi_raw1 ='' or number( /data/grp_easi_scale/easi_raw1 )&gt;=97, 0, number( /data/grp_easi_scale/easi_raw1 ))"/>
      <bind nodeset="/data/grp_easi_scale/easi_raw2" type="string" required="true()"/>
      <bind nodeset="/data/grp_easi_scale/easi_q2" type="string" calculate="if( /data/grp_easi_scale/easi_raw2 ='' or number( /data/grp_easi_scale/easi_raw2 )&gt;=97, 0, if(number( /data/grp_easi_scale/easi_raw2 )=1, 0, 1))"/>
      <bind nodeset="/data/grp_easi_scale/easi_raw3" type="string" required="true()"/>
      <bind nodeset="/data/grp_easi_scale/easi_q3" type="string" calculate="if( /data/grp_easi_scale/easi_raw3 ='' or number( /data/grp_easi_scale/easi_raw3 )&gt;=97, 0, number( /data/grp_easi_scale/easi_raw3 ))"/>
      <bind nodeset="/data/grp_easi_scale/easi_raw4" type="string" required="true()"/>
      <bind nodeset="/data/grp_easi_scale/easi_q4" type="string" calculate="if( /data/grp_easi_scale/easi_raw4 ='' or number( /data/grp_easi_scale/easi_raw4 )&gt;=97, 0, if(number( /data/grp_easi_scale/easi_raw4 )=1, 0, 1))"/>
      <bind nodeset="/data/grp_easi_scale/easi_raw5" type="string" required="true()"/>
      <bind nodeset="/data/grp_easi_scale/easi_q5" type="string" calculate="if( /data/grp_easi_scale/easi_raw5 ='' or number( /data/grp_easi_scale/easi_raw5 )&gt;=97, 0, if(number( /data/grp_easi_scale/easi_raw5 )=1, 0, 1))"/>
      <bind nodeset="/data/grp_easi_scale/easi_raw6" type="string" required="true()"/>
      <bind nodeset="/data/grp_easi_scale/easi_q6" type="string" calculate="if( /data/grp_easi_scale/easi_raw6 ='' or number( /data/grp_easi_scale/easi_raw6 )&gt;=97, 0, if(number( /data/grp_easi_scale/easi_raw6 )=1, 0, 1))"/>
      <bind nodeset="/data/grp_easi_scale/easi_raw7" type="string" required="true()"/>
      <bind nodeset="/data/grp_easi_scale/easi_q7" type="string" calculate="if( /data/grp_easi_scale/easi_raw7 ='' or number( /data/grp_easi_scale/easi_raw7 )&gt;=97, 0, if(number( /data/grp_easi_scale/easi_raw7 )=1, 0, 1))"/>
      <bind nodeset="/data/grp_easi_scale/easi_raw8" type="string" required="true()"/>
      <bind nodeset="/data/grp_easi_scale/easi_q8" type="string" calculate="if( /data/grp_easi_scale/easi_raw8 ='' or number( /data/grp_easi_scale/easi_raw8 )&gt;=97, 0, if(number( /data/grp_easi_scale/easi_raw8 )=1, 0, 1))"/>
      <bind nodeset="/data/grp_easi_scale/easi_raw9" type="string" required="true()"/>
      <bind nodeset="/data/grp_easi_scale/easi_q9" type="string" calculate="if( /data/grp_easi_scale/easi_raw9 ='' or number( /data/grp_easi_scale/easi_raw9 )&gt;=97, 0, if(number( /data/grp_easi_scale/easi_raw9 )=1, 0, 1))"/>
      <bind nodeset="/data/grp_easi_scale/easi_raw10" type="string" required="true()"/>
      <bind nodeset="/data/grp_easi_scale/easi_q10" type="string" calculate="if( /data/grp_easi_scale/easi_raw10 ='' or number( /data/grp_easi_scale/easi_raw10 )&gt;=97, 0, if(number( /data/grp_easi_scale/easi_raw10 )=1, 0, 1))"/>
      <bind nodeset="/data/grp_easi_scale/easi_raw11" type="string" required="true()"/>
      <bind nodeset="/data/grp_easi_scale/easi_q11" type="string" calculate="if( /data/grp_easi_scale/easi_raw11 ='' or number( /data/grp_easi_scale/easi_raw11 )&gt;=97, 0, if(number( /data/grp_easi_scale/easi_raw11 )=1, 0, 1))"/>
      <bind nodeset="/data/grp_easi_scale/easi_raw12" type="string" required="true()"/>
      <bind nodeset="/data/grp_easi_scale/easi_q12" type="string" calculate="if( /data/grp_easi_scale/easi_raw12 ='' or number( /data/grp_easi_scale/easi_raw12 )&gt;=97, 0, number( /data/grp_easi_scale/easi_raw12 ))"/>
      <bind nodeset="/data/grp_easi_scale/easi_total" type="string" calculate="coalesce( /data/grp_easi_scale/easi_q1 ,0)+coalesce( /data/grp_easi_scale/easi_q2 ,0)+coalesce( /data/grp_easi_scale/easi_q3 ,0)+coalesce( /data/grp_easi_scale/easi_q4 ,0)+coalesce( /data/grp_easi_scale/easi_q5 ,0)+coalesce( /data/grp_easi_scale/easi_q6 ,0)+coalesce( /data/grp_easi_scale/easi_q7 ,0)+coalesce( /data/grp_easi_scale/easi_q8 ,0)+coalesce( /data/grp_easi_scale/easi_q9 ,0)+coalesce( /data/grp_easi_scale/easi_q10 ,0)+coalesce( /data/grp_easi_scale/easi_q11 ,0)+coalesce( /data/grp_easi_scale/easi_q12 ,0)"/>
      <bind nodeset="/data/grp_easi_scale/_NOTE_easi" readonly="true()" type="string"/>
      <bind nodeset="/data/grp_easi_scale/display_score_easi" readonly="true()" type="string"/>
      <bind nodeset="/data/grp_easi_scale/Survey_Status_easi" type="string" required="true()"/>
      <bind nodeset="/data/grp_easi_scale/Reason_for_Dropout_easi" type="string" required="true()" relevant=" /data/grp_easi_scale/Survey_Status_easi  = 'dropout___discontinued'"/>
      <bind nodeset="/data/g_supporting_docs/upload_scale_image" type="binary" required="false()"/>
      <bind nodeset="/data/g_supporting_docs/upload_scale_pdf" type="binary" required="false()"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <group appearance="field-list" ref="/data/inputs">
      <label>Participant</label>
      <group appearance="field-list" ref="/data/inputs/user">
        <label>User</label>
      </group>
      <group appearance="field-list" ref="/data/inputs/contact">
        <label>Select participant</label>
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-participant">
          <label>Select participant</label>
        </input>
      </group>
    </group>
    <group appearance="field-list" ref="/data/g_participant">
      <label>Participant details &amp; consent</label>
      <select1 ref="/data/g_participant/consent_confirmed">
        <label>Did the participant (or guardian) provide informed consent for this assessment?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/g_participant/patient_name_display">
        <label>Participant Name</label>
      </input>
      <input ref="/data/g_participant/assessment_date">
        <label>Date of assessment</label>
      </input>
      <input ref="/data/g_participant/dob">
        <label>Date of birth</label>
      </input>
    </group>
    <group ref="/data/grp_easi_scale">
      <label>Everyday Abilities Scale for India (EASI)</label>
      <input ref="/data/grp_easi_scale/_Instructions_easi">
        <label>**Instructions:** The question can be asked by the caregiver or if not available directly from participant.</label>
      </input>
      <select1 ref="/data/grp_easi_scale/easi_raw1">
        <label>1. Forgets he/she has just eaten and asks for food again</label>
        <itemset nodeset="instance('easi_yesno')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_easi_scale/easi_raw2">
        <label>2. Urinates in an appropriate place</label>
        <itemset nodeset="instance('easi_yesno')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_easi_scale/easi_raw3">
        <label>3. Clothes get dirty from urine or stools</label>
        <itemset nodeset="instance('easi_yesno')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_easi_scale/easi_raw4">
        <label>4. Is his/her shirt buttoned properly?</label>
        <itemset nodeset="instance('easi_yesno')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_easi_scale/easi_raw5">
        <label>5. Does he/she have their Dhoti/petticoat/saree tied properly?</label>
        <itemset nodeset="instance('easi_yesno')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_easi_scale/easi_raw6">
        <label>6. He/she able to work as a member of a team i.e in a group activity, which requires different roles from people, will he/she be able to participate?</label>
        <itemset nodeset="instance('easi_yesno')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_easi_scale/easi_raw7">
        <label>7. Does he/she express his/her opinion appropriately on important family matters, eg: marriage?</label>
        <itemset nodeset="instance('easi_yesno')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_easi_scale/easi_raw8">
        <label>8. If he/she is assigned or himself/herself decides to undertake an important task, can he/she follow it through completion?</label>
        <itemset nodeset="instance('easi_yesno')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_easi_scale/easi_raw9">
        <label>9. Is he/she able to remember important festivals such as Holi, Diwali?</label>
        <itemset nodeset="instance('easi_yesno')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_easi_scale/easi_raw10">
        <label>10. If he/she is asked to deliver a message, does he/she remember to do so?</label>
        <itemset nodeset="instance('easi_yesno')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_easi_scale/easi_raw11">
        <label>11. Does he/she appropriately discuss local/regional evens such as marriages, disasters, politics?</label>
        <itemset nodeset="instance('easi_yesno')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_easi_scale/easi_raw12">
        <label>12. Does he/she ever lose his/her way in the village/area?</label>
        <itemset nodeset="instance('easi_yesno')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/grp_easi_scale/_NOTE_easi">
        <label>**NOTE:** A higher total score reflects greater overall disability. If the subject could not generally perform the activity, the reason for non-performance was ascertained. Responses clearly indicative of physical or mental problems or both were so coded. Ambiguous responses were probed and only when it was obvious that no further clarification was forthcoming were they left as such.</label>
      </input>
      <input ref="/data/grp_easi_scale/display_score_easi">
        <label>
          **EASI (Everyday Abilities) Score:**
          <output value=" /data/grp_easi_scale/easi_total "/>
          / 12

**Interpretation:** A higher total score reflects greater overall disability.
        </label>
      </input>
      <select1 ref="/data/grp_easi_scale/Survey_Status_easi">
        <label>Survey Status</label>
        <hint>Mark if the survey was completed or dropped out midway.</hint>
        <itemset nodeset="instance('easi_status')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/grp_easi_scale/Reason_for_Dropout_easi">
        <label>Reason for Dropout / Refusal:</label>
        <hint>Please explain why the survey was stopped.</hint>
      </input>
    </group>
    <group appearance="field-list" ref="/data/g_supporting_docs">
      <label>Supporting Documents / Scale Upload</label>
      <upload ref="/data/g_supporting_docs/upload_scale_image" mediatype="image/*">
        <label>Upload completed scale / assessment sheet (image)</label>
        <hint>Upload clear photos of the completed paper scale, consent form, or supporting assessment document. Accepts JPG, JPEG, PNG. For PDF use next field.</hint>
      </upload>
      <upload ref="/data/g_supporting_docs/upload_scale_pdf" mediatype="application/*">
        <label>Upload completed scale / assessment sheet (PDF)</label>
        <hint>Upload a PDF of the completed paper scale if not already uploaded as image. Accepts PDF.</hint>
      </upload>
    </group>
  </h:body>
</h:html>