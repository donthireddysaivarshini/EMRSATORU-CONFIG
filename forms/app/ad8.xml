<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>AD8 Dementia Screening Interview</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="ad8" version="2026-11-05 17-00" prefix="J1!ad8!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source/>
            <source_id/>
            <user>
              <contact_id/>
              <name/>
            </user>
            <contact>
              <_id/>
              <patient_id/>
              <name/>
              <date_of_birth/>
              <sex/>
              <age/>
              <phone/>
            </contact>
          </inputs>
          <patient_uuid/>
          <patient_id/>
          <patient_name/>
          <screened_by/>
          <screened_by_name/>
          <g_participant>
            <consent_confirmed/>
            <patient_name_display/>
            <assessment_date/>
            <dob/>
          </g_participant>
          <grp_ad8_scale>
            <_Instructions_ad8/>
            <ad8_q1/>
            <ad8_q2/>
            <ad8_q3/>
            <ad8_q4/>
            <ad8_q5/>
            <ad8_q6/>
            <ad8_q7/>
            <ad8_q8/>
            <ad8_total/>
            <display_score_ad8/>
            <Survey_Status_ad8/>
            <Reason_for_Dropout_ad8/>
          </grp_ad8_scale>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
          <item>
            <name>_not_completed___unable_to_und</name>
            <label>Not completed - Unable to understand / answer (comprehension barrier)</label>
          </item>
          <item>
            <name>nc_instruct</name>
            <label>Not completed - Unable to follow instructions (could not complete tasks as instructed)</label>
          </item>
          <item>
            <name>nc_dropout</name>
            <label>Not completed - Dropout (left early / discontinued)</label>
          </item>
        </root>
      </instance>
      <instance id="ad8_options">
        <root>
          <item>
            <name>1</name>
            <label>Yes, a change</label>
          </item>
          <item>
            <name>0</name>
            <label>No, no change</label>
          </item>
          <item>
            <name>99</name>
            <label>Don't Know/ NA</label>
          </item>
          <item>
            <name>98</name>
            <label>Not completed - Unable to follow instructions (could not complete tasks as instructed)</label>
          </item>
          <item>
            <name>97</name>
            <label>Not completed - Dropout (left early / discontinued)</label>
          </item>
        </root>
      </instance>
      <instance id="ad8_status">
        <root>
          <item>
            <name>completed</name>
            <label>Completed</label>
          </item>
          <item>
            <name>dropout___discontinued</name>
            <label>Dropout / Discontinued</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/age" type="string"/>
      <bind nodeset="/data/inputs/contact/phone" type="string"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" calculate="coalesce(../inputs/contact/patient_id, ../inputs/contact/_id)"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/screened_by" type="string" calculate="../inputs/user/contact_id"/>
      <bind nodeset="/data/screened_by_name" type="string" calculate="../inputs/user/name"/>
      <bind nodeset="/data/g_participant/consent_confirmed" type="string" required="true()"/>
      <bind nodeset="/data/g_participant/patient_name_display" type="string" required="true()" calculate="if(. = '',  /data/patient_name , .)"/>
      <bind nodeset="/data/g_participant/assessment_date" type="date" required="true()" calculate="if(. = '', today(), .)" constraint=". &lt;= today()" jr:constraintMsg="Date of assessment cannot be in the future."/>
      <bind nodeset="/data/g_participant/dob" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="Date of birth cannot be in the future."/>
      <bind nodeset="/data/grp_ad8_scale/_Instructions_ad8" readonly="true()" type="string"/>
      <bind nodeset="/data/grp_ad8_scale/ad8_q1" type="string" required="true()"/>
      <bind nodeset="/data/grp_ad8_scale/ad8_q2" type="string" required="true()"/>
      <bind nodeset="/data/grp_ad8_scale/ad8_q3" type="string" required="true()"/>
      <bind nodeset="/data/grp_ad8_scale/ad8_q4" type="string" required="true()"/>
      <bind nodeset="/data/grp_ad8_scale/ad8_q5" type="string" required="true()"/>
      <bind nodeset="/data/grp_ad8_scale/ad8_q6" type="string" required="true()"/>
      <bind nodeset="/data/grp_ad8_scale/ad8_q7" type="string" required="true()"/>
      <bind nodeset="/data/grp_ad8_scale/ad8_q8" type="string" required="true()"/>
      <bind nodeset="/data/grp_ad8_scale/ad8_total" type="string" calculate="if(number( /data/grp_ad8_scale/ad8_q1 )&lt;90, number( /data/grp_ad8_scale/ad8_q1 ), 0) + if(number( /data/grp_ad8_scale/ad8_q2 )&lt;90, number( /data/grp_ad8_scale/ad8_q2 ), 0) + if(number( /data/grp_ad8_scale/ad8_q3 )&lt;90, number( /data/grp_ad8_scale/ad8_q3 ), 0) + if(number( /data/grp_ad8_scale/ad8_q4 )&lt;90, number( /data/grp_ad8_scale/ad8_q4 ), 0) + if(number( /data/grp_ad8_scale/ad8_q5 )&lt;90, number( /data/grp_ad8_scale/ad8_q5 ), 0) + if(number( /data/grp_ad8_scale/ad8_q6 )&lt;90, number( /data/grp_ad8_scale/ad8_q6 ), 0) + if(number( /data/grp_ad8_scale/ad8_q7 )&lt;90, number( /data/grp_ad8_scale/ad8_q7 ), 0) + if(number( /data/grp_ad8_scale/ad8_q8 )&lt;90, number( /data/grp_ad8_scale/ad8_q8 ), 0)"/>
      <bind nodeset="/data/grp_ad8_scale/display_score_ad8" readonly="true()" type="string"/>
      <bind nodeset="/data/grp_ad8_scale/Survey_Status_ad8" type="string" required="true()"/>
      <bind nodeset="/data/grp_ad8_scale/Reason_for_Dropout_ad8" type="string" required="true()" relevant=" /data/grp_ad8_scale/Survey_Status_ad8  = 'dropout___discontinued'"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <group appearance="field-list" ref="/data/inputs">
      <label>Participant</label>
      <group appearance="field-list" ref="/data/inputs/user">
        <label>User</label>
      </group>
      <group appearance="field-list" ref="/data/inputs/contact">
        <label>Select participant</label>
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-participant">
          <label>Select participant</label>
        </input>
      </group>
    </group>
    <group appearance="field-list" ref="/data/g_participant">
      <label>Participant details &amp; consent</label>
      <select1 ref="/data/g_participant/consent_confirmed">
        <label>Did the participant (or guardian) provide informed consent for this assessment?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/g_participant/patient_name_display">
        <label>Participant Name</label>
      </input>
      <input ref="/data/g_participant/assessment_date">
        <label>Date of assessment</label>
      </input>
      <input ref="/data/g_participant/dob">
        <label>Date of birth</label>
      </input>
    </group>
    <group ref="/data/grp_ad8_scale">
      <label>AD8 Dementia Screening Interview</label>
      <input ref="/data/grp_ad8_scale/_Instructions_ad8">
        <label>**Instructions:** Remember, "Yes, a change" indicates that there has been a change in the last several years caused by cognitive (thinking and memory) problems.</label>
      </input>
      <select1 ref="/data/grp_ad8_scale/ad8_q1">
        <label>1. Problems with judgment (bad financial decisions, problems with thinking)</label>
        <itemset nodeset="instance('ad8_options')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_ad8_scale/ad8_q2">
        <label>2. Less interest in hobbies/activities</label>
        <itemset nodeset="instance('ad8_options')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_ad8_scale/ad8_q3">
        <label>3. Repeats the same things over and over (questions, stories, statements)</label>
        <itemset nodeset="instance('ad8_options')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_ad8_scale/ad8_q4">
        <label>4. Trouble learning how to use a tool, appliance, or gadget</label>
        <itemset nodeset="instance('ad8_options')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_ad8_scale/ad8_q5">
        <label>5. Forgets correct month or year</label>
        <itemset nodeset="instance('ad8_options')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_ad8_scale/ad8_q6">
        <label>6. Trouble handling complicated financial affairs (taxes, bills, checkbook)</label>
        <itemset nodeset="instance('ad8_options')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_ad8_scale/ad8_q7">
        <label>7. Trouble remembering appointments</label>
        <itemset nodeset="instance('ad8_options')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/grp_ad8_scale/ad8_q8">
        <label>8. Daily problems with thinking and/or memory</label>
        <itemset nodeset="instance('ad8_options')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/grp_ad8_scale/display_score_ad8">
        <label>
          **AD8 (Dementia) Score:**
          <output value=" /data/grp_ad8_scale/ad8_total "/>
          / 8

**Interpretation:** Scores of 2 or above suggest that cognitive impairment is likely to be present and may require further assessment.
        </label>
      </input>
      <select1 ref="/data/grp_ad8_scale/Survey_Status_ad8">
        <label>Survey Status</label>
        <hint>Mark if the survey was completed or dropped out midway.</hint>
        <itemset nodeset="instance('ad8_status')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/grp_ad8_scale/Reason_for_Dropout_ad8">
        <label>Reason for Dropout / Refusal:</label>
        <hint>Please explain why the survey was stopped.</hint>
      </input>
    </group>
  </h:body>
</h:html>